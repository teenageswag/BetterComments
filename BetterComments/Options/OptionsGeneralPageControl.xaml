<UserControl
    x:Class="BetterComments.Options.OptionsGeneralPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="480"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,10,14,14">

            <!-- ══════════════════════════════════════════════════════
                 GLOBAL FONT SETTINGS
                 ══════════════════════════════════════════════════════ -->
            <GroupBox Header="Global Font Settings" Margin="0,0,0,10" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Font family -->
                    <Label Grid.Row="0" Grid.Column="0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Content="Font:" />
                    <ComboBox x:Name="FontsComboBox"
                              Grid.Row="0" Grid.Column="1"
                              Width="280" Margin="0,4"
                              HorizontalAlignment="Left"
                              SelectedItem="{Binding Font, Mode=TwoWay}" />

                    <!-- Size offset -->
                    <Label Grid.Row="1" Grid.Column="0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Content="Size Offset:" />
                    <StackPanel Grid.Row="1" Grid.Column="1"
                                Orientation="Horizontal" Margin="0,4">
                        <Slider x:Name="SizeSlider"
                                Width="250" Height="28"
                                Minimum="-3" Maximum="3"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight"
                                Value="{Binding Size, Mode=TwoWay}" />
                        <TextBlock Padding="6,2" VerticalAlignment="Center"
                                   Text="{Binding Value, ElementName=SizeSlider}" />
                    </StackPanel>

                    <!-- Opacity -->
                    <Label Grid.Row="2" Grid.Column="0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Content="Opacity:" />
                    <StackPanel Grid.Row="2" Grid.Column="1"
                                Orientation="Horizontal" Margin="0,4">
                        <Slider x:Name="OpacitySlider"
                                Width="250" Height="28"
                                Minimum="0" Maximum="1"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight"
                                Value="{Binding Opacity, Mode=TwoWay}" />
                        <TextBlock Padding="6,2" VerticalAlignment="Center"
                                   Text="{Binding Value, ElementName=OpacitySlider}" />
                    </StackPanel>

                    <!-- Italic -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <CheckBox VerticalAlignment="Center"
                                  IsChecked="{Binding Italic, Mode=TwoWay}" />
                        <Label VerticalAlignment="Center" Content="Italic" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ══════════════════════════════════════════════════════
                 PER-CLASSIFICATION SETTINGS  (2 × 2 grid)
                 ══════════════════════════════════════════════════════ -->
            <TextBlock Text="Per-Classification Options"
                       FontWeight="SemiBold" Margin="0,0,0,6" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── Critical ───────────────────────────────────── -->
                <GroupBox Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" Padding="8,6">
                    <GroupBox.Header>
                        <TextBlock FontWeight="Bold" Foreground="#FF2A3D" Text="&#x25A0; Critical" />
                    </GroupBox.Header>
                    <StackPanel>
                        <TextBlock Foreground="Gray" FontSize="10.5" Margin="0,0,0,6"
                                   Text="ERROR  ·  ERR  ·  FIXME  ·  FIX" />
                        <CheckBox Margin="0,2" Content="Bold"
                                  IsChecked="{Binding CriticalBold, Mode=TwoWay}" />
                        <CheckBox Margin="0,2" Content="Underline"
                                  IsChecked="{Binding CriticalUnderline, Mode=TwoWay}" />
                        <CheckBox Margin="0,2" Content="Highlight keyword only"
                                  IsChecked="{Binding CriticalHighlightKeywordOnly, Mode=TwoWay}" />
                    </StackPanel>
                </GroupBox>

                <!-- ── Warning ────────────────────────────────────── -->
                <GroupBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Padding="8,6">
                    <GroupBox.Header>
                        <TextBlock FontWeight="Bold" Foreground="#FFAA33" Text="&#x25A0; Warning" />
                    </GroupBox.Header>
                    <StackPanel>
                        <TextBlock Foreground="Gray" FontSize="10.5" Margin="0,0,0,6"
                                   Text="WARNING  ·  WARN" />
                        <CheckBox Margin="0,2" Content="Bold"
                                  IsChecked="{Binding WarningBold, Mode=TwoWay}" />
                        <CheckBox Margin="0,2" Content="Underline"
                                  IsChecked="{Binding WarningUnderline, Mode=TwoWay}" />
                        <CheckBox Margin="0,2" Content="Highlight keyword only"
                                  IsChecked="{Binding WarningHighlightKeywordOnly, Mode=TwoWay}" />
                    </StackPanel>
                </GroupBox>

                <!-- ── Ideas ──────────────────────────────────────── -->
                <GroupBox Grid.Row="1" Grid.Column="0" Padding="8,6">
                    <GroupBox.Header>
                        <TextBlock FontWeight="Bold" Foreground="#1AA9F5" Text="&#x25A0; Ideas" />
                    </GroupBox.Header>
                    <StackPanel>
                        <TextBlock Foreground="Gray" FontSize="10.5" Margin="0,0,0,6"
                                   Text="TODO  ·  IDEA  ·  OPTIMIZE" />
                        <CheckBox Margin="0,2" Content="Bold"
                                  IsChecked="{Binding IdeasBold, Mode=TwoWay}" />
                        <CheckBox Margin="0,2" Content="Underline"
                                  IsChecked="{Binding IdeasUnderline, Mode=TwoWay}" />
                        <CheckBox Margin="0,2" Content="Highlight keyword only"
                                  IsChecked="{Binding IdeasHighlightKeywordOnly, Mode=TwoWay}" />
                    </StackPanel>
                </GroupBox>

                <!-- ── Info ───────────────────────────────────────── -->
                <GroupBox Grid.Row="1" Grid.Column="2" Padding="8,6">
                    <GroupBox.Header>
                        <TextBlock FontWeight="Bold" Foreground="#6FEA2D" Text="&#x25A0; Info" />
                    </GroupBox.Header>
                    <StackPanel>
                        <TextBlock Foreground="Gray" FontSize="10.5" Margin="0,0,0,6"
                                   Text="NOTE  ·  INFO" />
                        <CheckBox Margin="0,2" Content="Bold"
                                  IsChecked="{Binding InfoBold, Mode=TwoWay}" />
                        <CheckBox Margin="0,2" Content="Underline"
                                  IsChecked="{Binding InfoUnderline, Mode=TwoWay}" />
                        <CheckBox Margin="0,2" Content="Highlight keyword only"
                                  IsChecked="{Binding InfoHighlightKeywordOnly, Mode=TwoWay}" />
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 CUSTOM TAGS
                 ══════════════════════════════════════════════════════ -->
            <GroupBox Header="Custom Tags" Margin="0,10,0,0" Padding="8,6">
                <StackPanel>
                    <TextBlock Foreground="Gray" FontSize="10.5" Margin="0,0,0,6"
                               Text="Define custom comment tags (e.g., REVIEW, HACK, DEPRECATED)" />

                    <!-- Custom tags list -->
                    <Grid Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tag" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Maps To" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Custom" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Enabled" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Grid>

                        <!-- Tags list -->
                        <ListBox Grid.Row="1" Grid.Column="0"
                                 x:Name="CustomTagsListBox"
                                 SelectionChanged="CustomTagsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Tag}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" 
                                                  SelectedValue="{Binding MappedType, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem Content="Critical" Tag="Critical" />
                                            <ComboBoxItem Content="Warning" Tag="Warning" />
                                            <ComboBoxItem Content="Ideas" Tag="Ideas" />
                                            <ComboBoxItem Content="Info" Tag="Info" />
                                        </ComboBox>
                                        <CheckBox Grid.Column="2" 
                                                  IsChecked="{Binding UseCustomColor, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" />
                                        <CheckBox Grid.Column="3" 
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Add/Remove buttons -->
                        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top">
                            <Button Content="+" Width="24" Height="24" Margin="0,0,0,4"
                                    Click="AddCustomTag_Click" />
                            <Button Content="-" Width="24" Height="24"
                                    Click="RemoveCustomTag_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Add new tag -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="NewTagTextBox" 
                                 Margin="0,0,8,0" VerticalAlignment="Center"
                                 MaxLength="20" />
                        <TextBlock Grid.Column="1" Text="Tag name (e.g., REVIEW)" 
                                   VerticalAlignment="Center" Foreground="Gray" />
                    </Grid>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
